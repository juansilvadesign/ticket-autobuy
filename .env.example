# Telegram -- the Pix handoff. Reuses the SAME bot as price-watcher; there is no
# second bot to approve. Copy the values from ../price-watcher/.env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ⛔ Deliberately NOT here: BUYTICKET_EMAIL / BUYTICKET_PASSWORD.
# The session is established by `python buy.py login`, which opens a real browser and
# lets YOU type the password. Storing the password would buy nothing -- the session
# file is what the buy path actually reads -- while adding a credential that a stack
# trace, a `set -x`, or a screenshot could leak. If you later automate re-login,
# add them then and accept that cost knowingly.
